Name: Course agent
Description: Open the course AI agent (Codex or Claude Code) in the Terminal, in the current project.
Binding: agent
Interactive: true

Name: Course setup
Description: Check every course sign-in, fix what is missing, and print a pass or fail report.
Binding: setup
Interactive: true

Name: Build minisite
Description: Build your landing page and deck into docs/, then preview them. Commit and push docs/ to publish.
Binding: build_site
Interactive: true
