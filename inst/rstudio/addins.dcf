Name: Course agent
Description: Open the course AI agent in the Terminal, in the current project.
Binding: agent
Interactive: true

Name: Course agent (alternative)
Description: Open the other installed agent (Codex), for when the course agent is down or slow.
Binding: agent_other
Interactive: true

Name: Course setup
Description: Check every course sign-in, fix what is missing, and print a pass or fail report.
Binding: setup
Interactive: true
