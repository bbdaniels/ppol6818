# PPOL 6818 course folder: load the course keys (KoboToolbox, IPUMS) in every
# session, including Rscript runs; when the R console starts here, make the
# session reachable by the course agent, finish setup the first time, and
# afterwards bring the course repositories up to date.
if (requireNamespace("ppol6818", quietly = TRUE)) {
  ppol6818::load_keys()
  if (interactive()) {
    ppol6818::console_attach()
    try(ppol6818::on_open())
  }
}
